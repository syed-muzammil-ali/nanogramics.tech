{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "dist",
  "rewrites": [
    {"source": "/admin", "destination": "/admin/index.html"},
    {"source": "/admin/", "destination": "/admin/index.html"},
    {"source": "/pos", "destination": "/pos/index.html"},
    {"source": "/pos/", "destination": "/pos/index.html"},
    {"source": "/pos/:path*", "destination": "/pos/:path*"}
  ]
}
